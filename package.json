{
  "name": "lab-pwa-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lab 006: a private app on the phone, with passkey sign-in and approvals, built on Plain Function's capabilities.",
  "imports": {
    "#capabilities": "./capabilities/index.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler dev --config wrangler.toml",
    "dev:tunnel": "node scripts/tunnel.mjs",
    "dev:secrets": "node scripts/dev-secrets.mjs",
    "db:local": "wrangler d1 execute pwa-shell --local --config wrangler.toml --file capabilities/core/schema.sql",
    "db:remote": "wrangler d1 execute pwa-shell --remote --config wrangler.toml --file capabilities/core/schema.sql",
    "invite": "node scripts/invite.mjs",
    "deploy": "node scripts/build.mjs && wrangler deploy --config wrangler.toml",
    "typecheck": "tsc -p tsconfig.json && tsc -p capabilities/core/pwa/shell/tsconfig.json && tsc -p capabilities/core/pwa/shell/tsconfig.sw.json",
    "sync:capabilities": "node scripts/sync-capabilities.mjs",
    "check:capabilities": "node scripts/sync-capabilities.mjs --check",
    "test": "node scripts/sync-capabilities.mjs --check && node scripts/build.mjs --check && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@cloudflare/vitest-pool-workers": "0.18.6",
    "@cloudflare/workers-types": "4.20260702.1",
    "@types/node": "24.13.2",
    "esbuild": "0.28.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.107.0"
  }
}
